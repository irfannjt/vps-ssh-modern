generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { ADMIN RESELLER USER }
enum AccountStatus { ACTIVE EXPIRED DISABLED }

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  resellerId   String?
  reseller     User?    @relation("ResellerUsers", fields: [resellerId], references: [id])
  customers    User[]   @relation("ResellerUsers")
  accounts     SshAccount[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SshAccount {
  id          String        @id @default(cuid())
  username    String        @unique
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id])
  expiresAt   DateTime
  maxSessions Int           @default(1)
  status      AccountStatus @default(ACTIVE)
  isTrial     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([ownerId, status])
  @@index([expiresAt, status])
}
